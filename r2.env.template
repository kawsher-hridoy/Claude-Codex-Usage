# Cloudflare R2 credentials for backup-db-to-r2.sh
#
# Copy this file to your real (gitignored) secrets location and fill in the
# values from the Cloudflare dashboard, then lock it down:
#
#   mkdir -p ~/.config/r2-backup
#   cp r2.env.template ~/.config/r2-backup/r2.env
#   chmod 600 ~/.config/r2-backup/r2.env
#   $EDITOR ~/.config/r2-backup/r2.env
#
# Create the token under: R2 > Manage API Tokens > Create API Token,
# scoped to your bucket with "Object Read & Write". Keep the bucket private.
#
# NEVER commit the filled-in file. This template (placeholders only) is safe.

# Cloudflare account id (the subdomain of your R2 S3 endpoint).
R2_ACCOUNT_ID=your_account_id_here

# R2 API token credentials (Access Key ID / Secret Access Key).
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# Target bucket name.
R2_BUCKET_NAME=your_bucket_name_here

# S3-compatible endpoint. Usually: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://your_account_id_here.r2.cloudflarestorage.com

# ---- optional ----
# Key prefix (folder) inside the bucket. Default: claude-usage
# R2_PREFIX=claude-usage
# Set to 1 to also keep timestamped copies under <prefix>/history/.
# R2_KEEP_HISTORY=0
